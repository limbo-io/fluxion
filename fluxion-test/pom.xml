<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.limbo-io</groupId>
        <artifactId>fluxion</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>fluxion-test</artifactId>
    <description>All Testing</description>

    <properties>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven-surefire-plugin.version>3.0.0-M7</maven-surefire-plugin.version>
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <dependencies>
        <!-- Server Starter -->
        <dependency>
            <groupId>io.github.limbo-io</groupId>
            <artifactId>fluxion-server-spring-boot-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.limbo-io</groupId>
            <artifactId>fluxion-worker-spring-boot-starter</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- mysql-integration-test profile 的真实 MySQL 驱动：starter 不携带，
             版本与生产（fluxion-server-start）保持一致 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.28</version>
            <scope>test</scope>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>3.6.28</version>
            <scope>test</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/integration/mysql/**</exclude>
                        <!-- 集群 E2E 需 Podman/节点进程/自带数据库，只由 -Pcluster-e2e 运行 -->
                        <exclude>**/cluster/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 回归测试专用 Profile -->
        <profile>
            <id>regression-test</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                        <configuration>
                            <includes>
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/integration/mysql/**</exclude>
                                <!-- 集群 E2E 需完整集群环境，不属于常规回归 -->
                                <exclude>**/cluster/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <!-- H2 Integration Test Profile -->
        <profile>
            <id>h2-integration-test</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <!-- Skip regular tests, run only integration tests. -->
                <test.includes>**/mysql/*Test.java</test.includes>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                        <configuration>
                            <includes>
                                <include>**/integration/mysql/**/*Test.java</include>
                            </includes>
                            <excludes combine.self="override">
                                <!-- MySQL 原生方言断言（upsert 幂等写入、ON DUPLICATE KEY 独占
                                     锁语义）无法由 H2 表达，仅由真实 MySQL profile 承担；
                                     其余业务/事务语义由 H2 门禁覆盖。 -->
                                <exclude>**/integration/mysql/DistributedLockMySqlTest.java</exclude>
                                <exclude>**/integration/mysql/ExecutionIdentityUpsertMySqlTest.java</exclude>
                            </excludes>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Real-MySQL Integration Profile（需可用 MySQL，连不上则失败，不静默跳过） -->
        <profile>
            <id>mysql-integration-test</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                        <configuration>
                            <includes>
                                <include>**/integration/mysql/DistributedLockMySqlTest.java</include>
                                <include>**/integration/mysql/ExecutionIdentityUpsertMySqlTest.java</include>
                            </includes>
                            <!-- 必须 override：默认构建排除了 integration/mysql，
                                 若不覆盖，profile 的 include 会被默认 exclude 全部吃掉。
                                 （b0e5761 曾丢失此覆盖，profile 变成 0 发现测试的假门禁） -->
                            <excludes combine.self="override"/>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 集群 E2E 回归（批次 1）：只运行真实集群场景。
             Broker 可执行 jar 由 fluxion-server-start 的同名 profile 在 process-test-classes
             生成（classifier cluster-e2e）；Worker 不打包，直接以 surefire 的
             surefire.test.class.path（含 test-classes 与本次 reactor构建的模块 classes）
             用 java -cp 启动，保证节点运行当前代码。 -->
        <profile>
            <id>cluster-e2e</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                        <configuration>
                            <includes>
                                <include>**/cluster/**/*Test.java</include>
                            </includes>
                            <excludes combine.self="override"/>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
